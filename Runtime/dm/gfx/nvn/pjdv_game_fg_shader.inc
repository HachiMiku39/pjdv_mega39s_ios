static NSString *const pjdv_game_fg_shader = @"#include <metal_stdlib>\nusing namespace metal;\nstruct V { float4 p [[position]]; float2 uv; };\nvertex V fgVertex(uint id [[vertex_id]]) { float2 uv=float2((id<<1)&2,id&2); return {float4(uv*float2(2,-2)+float2(-1,1),0,1),uv}; }\nfragment float4 fgCopy(V in [[stage_in]], texture2d<float> t [[texture(0)]], constant float4& rect [[buffer(0)]]) {\n    constexpr sampler s(coord::normalized,filter::linear,address::clamp_to_edge);\n    float2 halfPixel=.5/float2(t.get_width(),t.get_height());\n    return float4(t.sample(s,clamp(rect.xy+in.uv*rect.zw,rect.xy+halfPixel,rect.xy+rect.zw-halfPixel)).rgb,1);\n}\nfloat errorAt(texture2d<float> a, texture2d<float> b, float2 p, float2 delta, float2 size) {\n    constexpr sampler s(coord::normalized,filter::linear,address::clamp_to_edge); float e=0;\n    for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) {\n        float2 uv=(p+float2(x,y)*5+.5)/size;\n        float3 d=a.sample(s,uv).rgb-b.sample(s,uv+delta/size).rgb;\n        e+=dot(d,d)/27;\n    }\n    return e;\n}\nkernel void fgFlow(texture2d<float> a [[texture(0)]], texture2d<float> b [[texture(1)]],\n                   texture2d<half,access::write> flow [[texture(2)]], device atomic_uint* stats [[buffer(0)]], uint2 q [[thread_position_in_grid]]) {\n    if(q.x>=flow.get_width()||q.y>=flow.get_height()) return;\n    float2 size=float2(a.get_width(),a.get_height()), p=(float2(q)+.5)*size/float2(flow.get_width(),flow.get_height())-.5;\n    float2 best=0; float cost=errorAt(a,b,p,best,size);\n    if(cost<0.00001){flow.write(half4(0,0,half(cost),1),q);atomic_fetch_add_explicit(&stats[0],1,memory_order_relaxed);return;}\n    // Coarse search, then two local refinements. The small displacement penalty\n    // prevents textureless regions selecting arbitrary equal-cost vectors.\n    for(int level=0;level<3;level++) {\n        float step=level==0?8:level==1?2:1; int radius=level==2?1:3; float2 center=best;\n        for(int y=-radius;y<=radius;y++) for(int x=-radius;x<=radius;x++) {\n            float2 d=center+float2(x,y)*step;\n            float c=errorAt(a,b,p,d,size)+dot(d,d)*0.0000001;\n            if(c<cost) { cost=c;best=d; }\n        }\n    }\n    flow.write(half4(half2(best),half(cost),1),q);\n    atomic_fetch_add_explicit(&stats[0],1,memory_order_relaxed);\n    if(cost>0.025) atomic_fetch_add_explicit(&stats[1],1,memory_order_relaxed);\n}\nkernel void fgMidpoint(texture2d<float> a [[texture(0)]], texture2d<float> b [[texture(1)]],\n                       texture2d<float> forward [[texture(2)]],texture2d<float> backward [[texture(3)]],\n                       texture2d<half,access::write> out [[texture(4)]], device uint* stats [[buffer(0)]], uint2 p [[thread_position_in_grid]]) {\n    if(p.x>=out.get_width()||p.y>=out.get_height()) return;\n    constexpr sampler s(coord::normalized,filter::linear,address::clamp_to_edge);\n    float2 size=float2(out.get_width(),out.get_height()),uv=(float2(p)+.5)/size;\n    float4 f=forward.sample(s,uv),r=backward.sample(s,uv);\n    float4 current=b.sample(s,uv);\n    // Whole-frame cut guard plus local disocclusion/consistency guard. Bypass\n    // uncertain pixels with a real current pixel; never blend across hard cuts.\n    bool cut=stats[0]>0 && stats[1]*2>stats[0];\n    bool valid=!cut && f.z<0.012 && r.z<0.012 && length(f.xy+r.xy)<4;\n    float2 ua=uv-f.xy/(2*size),ub=uv-r.xy/(2*size);\n    valid=valid && all(ua>=0) && all(ua<=1) && all(ub>=0) && all(ub<=1);\n    float3 ca=a.sample(s,ua).rgb,cb=b.sample(s,ub).rgb;\n    valid=valid && dot(ca-cb,ca-cb)<0.012;\n    out.write(half4(half3(valid?(ca+cb)*.5:current.rgb),1),p);\n}\n";
